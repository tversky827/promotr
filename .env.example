# =============================================================================
# Promotr — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# Variables marked REQUIRED must be set or the app refuses to boot in production.
# Variables marked OPTIONAL gate an integration: when unset, the corresponding
# feature reports "not configured" in the UI rather than pretending to work.
# =============================================================================

# --- Core ---------------------------------------------------------------------
# REQUIRED. Node environment: development | test | production
NODE_ENV=development

# REQUIRED. Public base URL of the app, no trailing slash. Used for links in
# emails, OAuth redirects, Stripe return URLs, webhook signatures and canonicals.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# REQUIRED. Base URL that tracking links are built from. Usually the same host,
# but you may point this at a dedicated short domain (e.g. https://prmo.tr).
NEXT_PUBLIC_TRACKING_URL=http://localhost:3000

# --- Branding (all optional; every value has a sensible default) ---------------
# The product is white-labelable: nothing below is hard-coded in the source.
NEXT_PUBLIC_BRAND_NAME=Promotr
NEXT_PUBLIC_BRAND_TAGLINE=Get paid to drive traffic.
NEXT_PUBLIC_BRAND_LEGAL_NAME=Promotr, Inc.
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_BRAND_LOGO_URL=
# Brand accent colour as space-separated HSL channels (Tailwind CSS variable form)
NEXT_PUBLIC_BRAND_PRIMARY_HSL=243 75% 59%

# --- Database -----------------------------------------------------------------
# REQUIRED. PostgreSQL 14+ connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/promotr?schema=public
# REQUIRED. Connection migrations run over. A pooler multiplexes sessions, and
# the advisory locks and DDL a migration takes need one session to itself — so
# when DATABASE_URL points at PgBouncer, Neon's pooled endpoint or Supabase's,
# this must be the direct endpoint. With no pooler, set it to the same value.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/promotr?schema=public

# --- Redis (optional but strongly recommended in production) -------------------
# Used for rate limiting, redirect caching and click-dedupe. When unset the app
# falls back to a single-process in-memory implementation, which is correct for
# local development but NOT safe across multiple server instances.
REDIS_URL=

# --- Secrets ------------------------------------------------------------------
# REQUIRED. 32-byte key, base64. Encrypts secrets at rest (MFA seeds, webhook
# secrets, OAuth tokens, tax IDs). Generate: openssl rand -base64 32
# Rotating this key invalidates previously encrypted values — see docs/SECURITY.md
APP_ENCRYPTION_KEY=

# REQUIRED. 32-byte key, base64. Salts/HMACs pseudonymous identifiers (IP hashes,
# device fingerprints) so raw IPs are never stored. Generate: openssl rand -base64 32
IP_HASH_SECRET=

# --- Stripe (OPTIONAL — payments disabled until set) ---------------------------
# Brand funding, creator payouts and identity verification all run through Stripe.
# Without these, the app shows "Stripe is not configured" and blocks money flows.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for the main webhook endpoint (/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Connect webhook endpoint (/api/webhooks/stripe/connect).
# If you route Connect events to the same endpoint, leave blank.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Required only for Stripe Connect OAuth ("standard" accounts). Express/Custom
# onboarding via Account Links does not need it.
STRIPE_CONNECT_CLIENT_ID=
# express | standard | custom — the Connect account type created for publishers
STRIPE_CONNECT_ACCOUNT_TYPE=express

# --- Email (OPTIONAL — notifications queue but do not send until set) ----------
# Provider: resend | postmark | sendgrid | smtp | console
# `console` writes rendered emails to the server log; intended for development.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM="Promotr <no-reply@example.com>"
EMAIL_REPLY_TO=
# Only for EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Object storage (OPTIONAL — creative uploads and CSV exports) --------------
# Any S3-compatible service: AWS S3, Cloudflare R2, Backblaze B2, MinIO.
# When unset, uploads are rejected with a clear configuration error and exports
# are streamed directly to the browser instead of being stored.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for stored objects (CDN domain or the bucket's public URL)
S3_PUBLIC_URL=
# true for MinIO / most S3-compatible providers, false for AWS S3
S3_FORCE_PATH_STYLE=true

# --- Error monitoring (OPTIONAL) ----------------------------------------------
# Standard Sentry DSN. Errors are reported through Sentry's envelope API.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# 0.0–1.0 sample rate for performance traces
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Google OAuth (OPTIONAL — "Continue with Google" hidden until set) ---------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- URL safety screening (OPTIONAL) ------------------------------------------
# Google Safe Browsing API key. When set, campaign destination URLs are screened
# for malware/phishing during moderation. When unset, that check is skipped and
# the campaign is flagged for manual review instead.
SAFE_BROWSING_API_KEY=

# --- Background worker --------------------------------------------------------
# Number of jobs a single worker process claims per tick.
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=1000
# Shared secret protecting /api/cron/tick, so a scheduler (Vercel Cron, GitHub
# Actions, Kubernetes CronJob) can drive background jobs without a session. Only
# needed when you cannot run `npm run worker` as a long-lived process; the
# endpoint refuses every request while this is unset. Generate: openssl rand -hex 32
CRON_SECRET=

# --- Operational tuning -------------------------------------------------------
# Days of raw click/impression rows to retain before partitions are dropped.
# Aggregated statistics are retained indefinitely.
CLICK_RETENTION_DAYS=180
# Trust X-Forwarded-For. Enable only behind a proxy you control (Vercel, Cloudflare,
# an ALB). Leaving this on with a directly exposed server allows IP spoofing.
TRUST_PROXY=true
# Comma-separated CIDR list of additional trusted proxies (optional).
TRUSTED_PROXY_CIDRS=

# --- Bootstrap ----------------------------------------------------------------
# On first boot, if no admin exists and both are set, this admin account is
# created. Remove after the first successful login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
